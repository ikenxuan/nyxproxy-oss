# NyxProxy Docker 运行配置
# 复制为 .env.docker 后修改；.env.docker 已被 .gitignore 忽略。

# 承载 IPv6 /64 的网卡（必填）。可用 `ip route show default` 查看。
IFACE=eth0

# SOCKS5 监听端口
LISTEN_PORT=18080

# 地址池大小（受路由器 NDP 表限制，建议 64-128）
POOL_SIZE=64

# 单个地址使用多少次后轮换
MAX_USAGE=100

# 单个地址使用多少分钟后轮换
MAX_AGE=30

# SOCKS5 认证信息（必填，务必修改密码）
PROXY_USER=admin
PROXY_PASS=change_me_now

# 日志级别：0=关闭 1=基础 2=详细
DEBUG_LEVEL=1

# 可选：固定 DNS 查询使用的源地址（留空则随当前前缀自动更新）
# DNS_SOURCE_ADDRESS=2001:db8:1:2::1

# 可选：固定前缀（留空则自动跟随 ISP 前缀变化）
# PREFIX=2001:db8:1:2::/64

# Web 管理面板（首次启动时写入 /data/config.yaml；之后请用面板修改）
WEB_ENABLED=true
WEB_LISTEN=0.0.0.0
WEB_PORT=18081
WEB_USER=admin
WEB_PASS=change_me_now
# 内置 TLS 证书（可选；容器内路径，挂载示例见 README）
# WEB_TLS_CERT_FILE=/certs/tls.crt
# WEB_TLS_KEY_FILE=/certs/tls.key
# 仅在可信反向代理之后开启
WEB_TRUST_PROXY_HEADERS=false
WEB_COOKIE_SECURE=false
